# Server environment variables
# Copy to .env and fill in values (or set in Railway dashboard)

# PostgreSQL connection string (from Railway Postgres service)
DATABASE_URL=postgresql://user:password@host:port/database

# Environment mode
NODE_ENV=development

# JWT secret for authentication (must match frontend, use strong random value)
JWT_SECRET=your-jwt-secret-here

# CORS allowed origins (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# Admin credentials (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here
